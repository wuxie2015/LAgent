# Ollama's local API endpoint. Do not set this to an untrusted remote endpoint.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gpt-oss:120b-cloud

# Web search is an independent backend. Create a key at https://tavily.com/
# and keep it only in your local .env file.
TAVILY_API_KEY=

# Maximum number of search results returned to the model.
SEARCH_RESULT_LIMIT=5

# Log level written to data/logs/lin-agent.log. Never store secrets in logs.
LOG_LEVEL=INFO

# Layered memory. Relative directory paths resolve against the project root.
MEMORY_ENABLED=true
MEMORY_DIR=memory
MEMORY_RECENT_TURNS=10
# Character soft limits, not exact token limits. Configure for your model context.
MEMORY_CONTEXT_MAX_CHARS=48000
MEMORY_FACTS_MAX_CHARS=8000
MEMORY_TASKS_MAX_CHARS=6000
MEMORY_TOOL_CONTEXT_MAX_CHARS=4000
MEMORY_EXTRACTION_MAX_CHARS=24000
MEMORY_MAINTENANCE_CALLS=2
MEMORY_MAINTENANCE_TIMEOUT=30
MEMORY_BACKLOG_WARNING_TURNS=30
# Blank reuses OLLAMA_MODEL. Maintenance never gets executable tools.
MEMORY_MODEL=
MEMORY_DEBUG_CONTENT=false

# Durable reminders and read-only scheduled agent tasks. The CLI must remain running.
SCHEDULER_ENABLED=true
SCHEDULE_DB=data/schedules.sqlite3
SCHEDULE_TIMEZONE=Asia/Tokyo
SCHEDULE_DEFAULT_CHANNEL=console
SCHEDULE_POLL_INTERVAL=1
SCHEDULE_GRACE_SECONDS=300
SCHEDULE_MAX_NOTIFICATION_ATTEMPTS=5
NOTIFICATION_CONSOLE_ENABLED=true
# Email is available when SMTP_HOST, SMTP_FROM, and SMTP_TO are set. Credentials optional.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_TO=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
# Webhook requires HTTPS, or localhost HTTP for development.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=
NOTIFICATION_TIMEOUT=15
